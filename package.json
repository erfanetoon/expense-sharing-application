{
    "name": "expense-sharing",
    "author": "Expense Sharing",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "migrate": "pnpm --filter @backend/core migration:up && pnpm --filter @backend/core seed:up",
        "migrate:fresh": "pnpm --filter @backend/core migration:squash"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.1",
        "cross-env": "^10.1.0",
        "tsup": "^8.5.1",
        "turbo": "^2.10.5",
        "typescript": "5.9.2"
    },
    "packageManager": "pnpm@9.0.0",
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "tsx": "^4.23.0"
    }
}
